---
import Base from "@/layouts/Base.astro";
---

<Base
  title="Page introuvable"
  description="Cette page n'existe pas ou a été déplacée."
  noindex={true}
>
  <section class="section-sm text-center">
    <div class="container">
      <div class="row justify-center">
        <div class="sm:col-10 md:col-8 lg:col-6">
          <span
            class="text-[8rem] block font-bold text-text-dark dark:text-darkmode-text-dark"
          >
            404
          </span>
          <h1 class="h2 mb-4">Page introuvable</h1>
          <div class="content">
            <p>
              La page que vous cherchez a peut-être été déplacée, renommée, ou
              n'est plus disponible.
            </p>
          </div>
          <div class="mt-8 flex flex-wrap justify-center gap-3">
            <a href="/" class="btn btn-primary">Retour à l'accueil</a>
            <a href="/contact/" class="btn btn-outline-primary">Me contacter</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
