---
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import CookieBanner from "@/layouts/components/CookieBanner.astro";
import config from "@/config/config.json";
import {
  HAS_ABSOLUTE_URLS,
  IS_PREVIEW,
  PREVIEW_FEEDBACK_REPO,
  SITE_URL,
} from "@/config/siteUrl.mjs";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/partials/Footer.astro";
import Header from "@/partials/Header.astro";
import "@/styles/main.css";
import { ClientRouter } from "astro:transitions";

export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
}

const { title, meta_title, description, image, noindex, canonical } = Astro.props;

// plainify() round-trips through markdown, which leaves a trailing newline.
// Collapse whitespace so it never lands inside <title> or a meta description.
const clean = (s: string) => plainify(s).replace(/\s+/g, " ").trim();

const pageTitle = clean(meta_title ? meta_title : title ? title : config.site.title);
const pageTitleFull = (meta_title || title) ? `${pageTitle} | Auver'me` : pageTitle;
const pageDescription = clean(description ? description : config.metadata.meta_description);
const pageImage = `${SITE_URL}${image ? image : config.metadata.meta_image}`;
// En préversion sans URL connue, aucune URL absolue n'est émise : une
// canonique désignant la production, servie avec un noindex, risquerait de
// faire déréférencer la production elle-même.
const canonicalURL = HAS_ABSOLUTE_URLS
  ? (canonical ?? `${SITE_URL}${Astro.url.pathname}`)
  : null;

const schema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${SITE_URL}/#orthopedagogue`,
  "name": "Auver'me Orthopédagogie",
  "url": SITE_URL,
  "description": config.metadata.meta_description,
  "telephone": "+33672274017",
  "email": "contact.auverme@gmail.com",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Royat",
    "postalCode": "63130",
    "addressRegion": "Puy-de-Dôme",
    "addressCountry": "FR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 45.7705,
    "longitude": 3.0557
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
      "opens": "09:00",
      "closes": "19:00"
    }
  ],
  "priceRange": "50€–60€",
  "areaServed": [
    { "@type": "City", "name": "Royat" },
    { "@type": "City", "name": "Clermont-Ferrand" },
    { "@type": "Country", "name": "France" }
  ],
  "founder": {
    "@type": "Person",
    "name": "Anne Jauze",
    "jobTitle": "Orthopédagogue"
  },
  "sameAs": [
    "https://www.instagram.com/auvermeorthopedagogie/"
  ]
};
---

<!doctype html>
<html lang="fr">
  <head>
    <!-- favicon -->
    <link rel="shortcut icon" href={config.site.favicon} />
    <!-- theme meta -->
    <meta name="theme-color" content="#fdf8f0" />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    <!-- responsive meta -->
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />

    <!-- Google Fonts — preconnect then stylesheet (non render-blocking) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600&family=Fredoka:wght@500;600&display=swap" />

    <!-- title -->
    <title>{pageTitleFull}</title>

    <!-- canonical url -->
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <!-- noindex robots -->
    {/* La préversion Cloudflare n'est jamais indexable. */}
    {(noindex || IS_PREVIEW) && (
      <meta name="robots" content="noindex,nofollow" />
    )}

    <!-- meta-description -->
    <meta name="description" content={pageDescription} />

    <ClientRouter />

    <!-- author -->
    <meta name="author" content={config.metadata.meta_author} />

    <!-- og -->
    <meta property="og:title" content={pageTitleFull} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    {HAS_ABSOLUTE_URLS && <meta property="og:image" content={pageImage} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="fr_FR" />

    <!-- twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitleFull} />
    <meta name="twitter:description" content={pageDescription} />
    {HAS_ABSOLUTE_URLS && <meta name="twitter:image" content={pageImage} />}

    <!-- schema.org LocalBusiness -->
    {/* Données structurées omises en préversion : elles exigent des URLs
        absolues, et la page est de toute façon en noindex. */}
    {HAS_ABSOLUTE_URLS && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

  </head>
  <body class="flex flex-col min-h-screen">
    <Header />
    <main class="grow" id="main-content">
      <slot />
    </main>
    <Footer />
    <CookieBanner />
    <TwSizeIndicator />

    {/*
      Widget de retour BugDrop — PRÉVERSION UNIQUEMENT.
      Chaque remarque devient une issue dans un dépôt privé dédié.
      `is:inline` empêche Astro de regrouper le script : BugDrop lit sa
      configuration sur l'élément <script> en cours d'exécution, ce qui
      interdit aussi async et defer.
    */}
    {IS_PREVIEW && PREVIEW_FEEDBACK_REPO && (
      <script
        is:inline
        src="https://bugdrop.neonwatty.workers.dev/widget.js"
        data-repo={PREVIEW_FEEDBACK_REPO}
        data-label="Donner mon avis"
        data-welcome="Une remarque sur cette page ? Décrivez-la ici."
        data-position="bottom-right"
        data-screenshot="optional"
        data-show-issue-link="never"
      />
    )}
  </body>
</html>
