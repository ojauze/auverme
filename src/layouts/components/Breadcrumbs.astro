---
import { humanize } from "@/lib/utils/textConverter";

// humanize() capitalise la première lettre et passe le reste en minuscules,
// ce qui transforme "tdah" en "Tdah". Les sigles sont rétablis ici.
const ACRONYMS: Record<string, string> = {
  tdah: "TDAH",
  hpi: "HPI",
  faq: "FAQ",
};

const deacronymize = (label: string) =>
  label
    .split(" ")
    .map((word) => ACRONYMS[word.toLowerCase()] ?? word)
    .join(" ");

const { className }: { className?: string } = Astro.props;

const paths = Astro.url.pathname.split("/").filter((x) => x);
let parts = [
  {
    label: "Accueil",
    href: "/",
    "aria-label": Astro.url.pathname === "/" ? "page" : undefined,
  },
];

paths.forEach((label: string, i: number) => {
  // Slash final obligatoire : le site est servi en trailingSlash "always",
  // et un lien sans slash provoque une redirection 301 inutile.
  const href = `/${paths.slice(0, i + 1).join("/")}/`;
  label !== "page" &&
    parts.push({
      label:
        deacronymize(
          humanize(label.replace(".html", "").replace(/[-_]/g, " ")),
        ) || "",
      href,
      "aria-label": Astro.url.pathname === href ? "page" : undefined,
    });
});
---

<nav aria-label="Breadcrumb" class={className}>
  <ol class="inline-flex" role="list">
    {
      parts.map(({ label, ...attrs }, index) => (
        <li class="mx-1 capitalize" role="listitem">
          {index > 0 && <span class="inlin-block mr-1">/</span>}
          {index !== parts.length - 1 ? (
            <a class="text-primary dark:text-darkmode-primary" {...attrs}>
              {label}
            </a>
          ) : (
            <span class="text-text-light dark:text-darkmode-text-light">
              {label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
